{
  "manifest_version": 3,
  "name": "Litterbox for GitHub PRs",
  "short_name": "Litterbox",
  "version": "1.0.0",
  "description": "Scoop tests, snapshots and other noise out of GitHub pull request diffs, and see the +/− line count for what's left.",
  "homepage_url": "https://github.com/ai-meow/litterbox",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
